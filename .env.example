# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Production values live in Vercel env vars (set via dashboard or `vercel env add`).
# See CLAUDE.md "Environment Variables" section for the full list and source of each value.

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=GENERATE_64_CHAR_HEX_STRING
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://your-domain.com/api/auth/facebook/callback
TWOFACTOR_API_KEY=

# ── Email (ZeptoMail / Zoho) ─────────────────────────────────────────
# IMPORTANT: ZEPTOMAIL_TOKEN value MUST start with "Zoho-enczapikey " (literal prefix, with trailing space).
# Zoho's UI shows the token WITHOUT this prefix when you click Copy — add it manually.
# Without the prefix every email silently returns HTTP 401 / TM_4001 / "Invalid API Token found"
# and the catch in lib/daily-greetings.ts swallows it. This broke prod for ~2 days on 2026-04-29.
# Verify with: curl -X POST https://api.zeptomail.in/v1.1/email -H "Authorization: $ZEPTOMAIL_TOKEN" ...
ZEPTOMAIL_TOKEN=Zoho-enczapikey YOUR_TOKEN_BASE64_VALUE
ZEPTOMAIL_FROM_EMAIL=tanhowaadmin@tanhowa.in

# ── AI ───────────────────────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=

# ── Telegram bot ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Web Push (VAPID) ─────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Razorpay (online payments) ───────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Cron auth ────────────────────────────────────────────────────────
# Bearer token validated by every /api/cron/* route. Generate a long random string.
CRON_SECRET=
